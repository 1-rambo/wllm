  "calibration": "2026-10-18: the previous E2E-1 formal at impl/artifacts/evaluation/e2e-priority-pressure/darwin/llama-3.2-1b-instruct/2026-10-18T00-55-08.157Z/ was complete but exposed a protocol-validity flaw: 45 of 54 target records had already finished before their scheduled high-priority write, so the completion endpoint mostly compared unpromoted work. This version keeps the pressure ladder, ten-tab layout, models, prompts, token budget, five-percent completion threshold, and arm definitions unchanged. It uses one target per trial, applies high priority 500 ms after simultaneous task submission, keeps that target high until task completion, rotates the target across trials, excludes targets that finish before the priority write from completion, and adds a 90-percent active-at-request validity gate.",
  "scope": {
    "mainExperiments": ["e2e-1", "e2e-2"],
    "ablationExperiments": ["abl-1", "abl-2", "abl-3"],
    "platforms": {
      "main": ["darwin", "win32"],
      "ablation": ["darwin"]
    },
    "models": {
      "main": [
        "llama-3.2-1b-instruct",
        "llama-3.2-3b-instruct",
        "qwen2.5-1.5b-instruct",
