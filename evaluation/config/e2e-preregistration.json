      ],
      "ablation": [
        "llama-3.2-1b-instruct",
        "qwen2.5-1.5b-instruct"
      ]
    }
  },
  "protocol": {
    "priorityApi": "setSessionPriority",
    "priorityValues": ["high", "normal"],
    "visibilityDerivedPriority": false,
    "pressureSchedule": [
      { "id": "clear-1", "triangles": 0 },
      { "id": "pressure-250", "triangles": 250 },
      { "id": "pressure-500", "triangles": 500 },
      { "id": "pressure-750", "triangles": 750 },
      { "id": "pressure-1000", "triangles": 1000 },
      { "id": "clear-return", "triangles": 0 }
    ],
    "tabLayout": {
      "appTabs": 9,
      "artifexTabs": 1,
      "pressureTabs": 1,
      "totalTabs": 10
    },
    "repeats": 3,
    "samePromptAcrossArms": true,
    "samePressureAcrossArms": true,
    "sameRecoveryTimelineAcrossArms": true,
    "priorityTargetsPerTrial": 1,
    "targetHeldHighThroughCompletion": true,
    "blindJudge": true
  },
  "gates": {
    "e2e-1": [
