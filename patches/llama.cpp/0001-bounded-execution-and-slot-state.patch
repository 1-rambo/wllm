+    // not thread-safe, must be called from the main thread while the slot is idle.
+    bool slot_state_export(int id_slot, server_slot_state & out, bool clear_state = false);
+    bool slot_state_import(int id_slot, const server_slot_state & in, server_slot_state & out);
