 using server_state_callback_t = std::function<void(server_state, json /* payload */)>;
 
+// bounded serving support: in-memory transfer of a single slot's sequence state
+// (sequence KV cache bytes + prompt token bookkeeping), so that a serving slot
+// can be parked and later resumed without re-evaluating its prompt.
+enum server_slot_state_status {
+    SERVER_SLOT_STATE_OK           = 0,
+    SERVER_SLOT_STATE_INVALID_SLOT = 1,
+    SERVER_SLOT_STATE_BUSY         = 2,
+    SERVER_SLOT_STATE_EMPTY        = 3,
+    SERVER_SLOT_STATE_INTERNAL     = 4,
+};
+
+struct server_slot_state {
+    int status = SERVER_SLOT_STATE_OK;
+    int32_t n_tokens = 0;
+    // token-aligned serialization of the slot prompt, see server_tokens::serialize()
+    std::vector<llama_token> tokens;
+    // opaque sequence state blob (main context state followed by optional draft state)
+    std::vector<uint8_t> kv;
+};
+
 struct server_context {
     std::unique_ptr<server_context_impl> impl;
 
