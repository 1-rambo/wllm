+
+///////// Slot-scoped KV state (bounded serving support)
+
+// Export the KV cache of one serving slot so the host can park it in memory
+// (L2) or in persistent storage (L3) and later resume it without re-prefill.
+struct glue_msg_kvsv_req
+{
+  GLUE_HANDLER("kvsv_req")
+  GLUE_FIELD(int, slot_id)
+  GLUE_FIELD(bool, drop)
+};
+
+struct glue_msg_kvsv_res
+{
+  GLUE_HANDLER("kvsv_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+  GLUE_FIELD(int, n_bytes)
+  GLUE_FIELD(arr_int, tokens)
+  GLUE_FIELD(raw, data)
+};
+
+// Restore a previously exported KV state into a slot. The slot must be idle.
+struct glue_msg_kvld_req
+{
+  GLUE_HANDLER("kvld_req")
+  GLUE_FIELD(int, slot_id)
+  GLUE_FIELD(arr_int, tokens)
+  GLUE_FIELD(raw, data)
+};
+
+struct glue_msg_kvld_res
+{
+  GLUE_HANDLER("kvld_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+};
+
+// Drop the KV state of one idle slot without exporting it (bounded L1 eviction).
+struct glue_msg_kvdr_req
+{
+  GLUE_HANDLER("kvdr_req")
+  GLUE_FIELD(int, slot_id)
+};
+
+struct glue_msg_kvdr_res
+{
+  GLUE_HANDLER("kvdr_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+};
+
+///////// Parked sequence states (wasm-resident tier two)
+
+// Park a slot's sequence state inside the wasm heap under a handle and release
+// the live serving slot. Unlike kvsv, the state never crosses into the host,
+// so a parked node costs the host one integer handle and no heap copy.
+struct glue_msg_kvpk_req
+{
+  GLUE_HANDLER("kvpk_req")
+  GLUE_FIELD(int, slot_id)
+};
+
+struct glue_msg_kvpk_res
+{
+  GLUE_HANDLER("kvpk_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, handle)
+  GLUE_FIELD(int, n_tokens)
+  GLUE_FIELD(int, n_bytes)
+};
+
+// Restore a parked state into an idle slot. The parked copy is kept so the same
+// node can be parked and resumed repeatedly; the host releases it explicitly.
+struct glue_msg_kvrs_req
+{
+  GLUE_HANDLER("kvrs_req")
+  GLUE_FIELD(int, handle)
+  GLUE_FIELD(int, slot_id)
+};
+
+struct glue_msg_kvrs_res
+{
+  GLUE_HANDLER("kvrs_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+};
+
+// Serialize a parked state out to the host, which is the tier-three step: the
+// bytes leave the wasm heap and the native copy is released separately.
+struct glue_msg_kvrq_req
+{
+  GLUE_HANDLER("kvrq_req")
+  GLUE_FIELD(int, handle)
+};
+
+struct glue_msg_kvrq_res
+{
+  GLUE_HANDLER("kvrq_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+  GLUE_FIELD(int, n_bytes)
+  GLUE_FIELD(arr_int, tokens)
+  GLUE_FIELD(raw, data)
+};
+
+// Release a parked state without restoring it (tier-three flush or eviction).
+struct glue_msg_kvfd_req
+{
+  GLUE_HANDLER("kvfd_req")
+  GLUE_FIELD(int, handle)
+};
+
+struct glue_msg_kvfd_res
+{
+  GLUE_HANDLER("kvfd_res")
+  GLUE_FIELD(bool, success)
+  GLUE_FIELD(int, status)
+  GLUE_FIELD(int, n_tokens)
+  GLUE_FIELD(int, n_bytes)
+};
