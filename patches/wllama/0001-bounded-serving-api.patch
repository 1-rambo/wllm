+  // bounded serving: copy the KV state of an idle slot out of the context
+  glue_msg_kvsv_res action_kv_save(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvsv_req);
+    glue_msg_kvsv_res res;
+
+    server_slot_state state;
+    const bool ok = ctx_server.slot_state_export(req.slot_id.value, state, req.drop.value);
+
+    res.success.value = ok;
+    res.status.value = state.status;
+    res.n_tokens.value = state.n_tokens;
+    res.n_bytes.value = (int)state.kv.size();
+    res.tokens.arr = std::move(state.tokens);
+    res.data.buf.assign(
+        reinterpret_cast<const char *>(state.kv.data()),
+        reinterpret_cast<const char *>(state.kv.data()) + state.kv.size());
+    return res;
+  }
+
+  // bounded serving: install a previously exported KV state into an idle slot
+  glue_msg_kvld_res action_kv_load(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvld_req);
+    glue_msg_kvld_res res;
+
+    server_slot_state in;
+    in.tokens = req.tokens.arr;
+    in.kv.assign(
+        reinterpret_cast<const uint8_t *>(req.data.buf.data()),
+        reinterpret_cast<const uint8_t *>(req.data.buf.data()) + req.data.buf.size());
+
+    server_slot_state out;
+    const bool ok = ctx_server.slot_state_import(req.slot_id.value, in, out);
+
+    res.success.value = ok;
+    res.status.value = out.status;
+    res.n_tokens.value = out.n_tokens;
+    return res;
+  }
+
+  // bounded serving: release the KV state of an idle slot without exporting it
+  glue_msg_kvdr_res action_kv_drop(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvdr_req);
+    glue_msg_kvdr_res res;
+
+    server_slot_state out;
+    const bool ok = ctx_server.slot_state_clear(req.slot_id.value, out);
+
+    res.success.value = ok;
+    res.status.value = out.status;
+    res.n_tokens.value = out.n_tokens;
+    return res;
+  }
+
+  // tier two: move a slot's state into the wasm-side park bank and release the
+  // serving slot. The host receives a handle instead of the state bytes.
+  glue_msg_kvpk_res action_kv_park(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvpk_req);
+    glue_msg_kvpk_res res;
+
+    server_slot_state state;
+    const bool ok = ctx_server.slot_state_export(req.slot_id.value, state, true);
+
+    res.success.value = ok;
+    res.status.value = state.status;
+    res.n_tokens.value = state.n_tokens;
+    if (!ok)
+    {
+      res.handle.value = -1;
+      res.n_bytes.value = 0;
+      return res;
+    }
+
+    const int handle = next_park_handle++;
+    res.handle.value = handle;
+    res.n_bytes.value = (int)state.kv.size();
+    parked_states.emplace(handle, std::move(state));
+    return res;
+  }
+
+  // tier two: install a parked state into an idle slot without re-prefilling it.
+  // The parked copy survives, so a node can be parked again after the turn.
+  glue_msg_kvrs_res action_kv_resume(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvrs_req);
+    glue_msg_kvrs_res res;
+
+    auto it = parked_states.find(req.handle.value);
+    if (it == parked_states.end())
+    {
+      res.success.value = false;
+      res.status.value = SERVER_SLOT_STATE_EMPTY;
+      res.n_tokens.value = 0;
+      return res;
+    }
+
+    server_slot_state out;
+    const bool ok = ctx_server.slot_state_import(req.slot_id.value, it->second, out);
+
+    res.success.value = ok;
+    res.status.value = out.status;
+    res.n_tokens.value = out.n_tokens;
+    return res;
+  }
+
+  // tier three: serialize a parked state out to the host. The native copy stays
+  // until the host releases it, so a failed flush loses no state.
+  glue_msg_kvrq_res action_kv_read(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvrq_req);
+    glue_msg_kvrq_res res;
+
+    auto it = parked_states.find(req.handle.value);
+    if (it == parked_states.end())
+    {
+      res.success.value = false;
+      res.status.value = SERVER_SLOT_STATE_EMPTY;
+      res.n_tokens.value = 0;
+      res.n_bytes.value = 0;
+      return res;
+    }
+
+    const server_slot_state &state = it->second;
+    res.success.value = true;
+    res.status.value = state.status;
+    res.n_tokens.value = state.n_tokens;
+    res.n_bytes.value = (int)state.kv.size();
+    res.tokens.arr = state.tokens;
+    res.data.buf.assign(
+        reinterpret_cast<const char *>(state.kv.data()),
+        reinterpret_cast<const char *>(state.kv.data()) + state.kv.size());
+    return res;
+  }
+
+  // tier three: release a parked state once its serialized copy is durable.
+  glue_msg_kvfd_res action_kv_release(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_kvfd_req);
+    glue_msg_kvfd_res res;
+
+    auto it = parked_states.find(req.handle.value);
+    if (it == parked_states.end())
+    {
+      res.success.value = false;
+      res.status.value = SERVER_SLOT_STATE_EMPTY;
+      res.n_tokens.value = 0;
+      res.n_bytes.value = 0;
+      return res;
+    }
+
+    res.success.value = true;
+    res.status.value = SERVER_SLOT_STATE_OK;
+    res.n_tokens.value = it->second.n_tokens;
+    res.n_bytes.value = (int)it->second.kv.size();
+    parked_states.erase(it);
+    return res;
+  }
+
