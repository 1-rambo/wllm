+// struct glue_msg_kvsv_req
+export interface GlueMsgKvsvReq {
+  _name: "kvsv_req";
+  slot_id: number;
+  drop: boolean;
+}
+
+// struct glue_msg_kvsv_res
+export interface GlueMsgKvsvRes {
+  _name: "kvsv_res";
+  success: boolean;
+  status: number;
+  n_tokens: number;
